# Required: Zo Computer access token, usually starts with zo_sk_
ZO_ACCESS_TOKEN=zo_sk_your_token_here

# Optional: external API key accepted by this proxy.
# If omitted, server.js generates a random key on each start.
PROXY_API_KEY=sk-proxy-gateway-v1

# Optional flags.
PROXY_PROMPT_OVERRIDE=true
PROXY_OUTPUT_SANITIZE=false

# Service port exposed locally and in Docker.
PORT=8000
